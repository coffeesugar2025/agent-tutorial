APP_NAME=FastAPI Admin
DEBUG=true
SECRET_KEY=please-change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL
# asyncmy = 默认（需 0.2.10+ 的预编译 wheel）；aiomysql = 纯 Python 免编译，配合 requirements-nocompile.txt 使用
MYSQL_DRIVER=asyncmy
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=admin123
MYSQL_DB=admin_scaffold

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=admin.events

# Kafka (KRaft 单节点)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=admin.audit

# Elasticsearch
ES_HOSTS=http://localhost:9200
ES_INDEX=admin-audit
ES_USERNAME=
ES_PASSWORD=

# 组件开关：连不上时自动降级，不阻断主流程
ENABLE_REDIS=true
ENABLE_RABBITMQ=true
ENABLE_KAFKA=true
ENABLE_ES=true

# 初始管理员
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin@123
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
