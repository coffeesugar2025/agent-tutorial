# ---------- 运行模式 ----------
# mock  : 内置脚本化模型，无需任何 API Key，完整跑通 create_agent + MCP 工具链（默认）
# real  : 走 init_chat_model(MODEL_NAME)，需要对应厂商 Key
AGENT_MODE=mock
MODEL_NAME=openai:gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---------- MCP ----------
# stdio : 由 MCPAdapter 拉起本地 mcp_server/server.py 子进程（默认，零额外部署）
# http  : 连接已独立启动的 Streamable HTTP MCP 服务
MCP_TRANSPORT=stdio
MCP_HTTP_URL=http://127.0.0.1:9000/mcp
# 可选：使用 langchain_mcp_adapters.MultiServerMCPClient 而非 1.5 内置 MCPAdapter
MCP_CLIENT=builtin

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_TOOL_CALLS=8

# ---------- 可观测 ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecommerce-agent
