# =============================================================================
# 星图商城 · 电商智能体平台  环境变量样例
# 用法: cp .env.example .env  (deploy/ 目录下)  然后按需修改
# 约定: 本文件被 docker-compose*.yml 读取做变量插值，同时由 compose 注入容器。
#      不要在此处使用 export / 引号 / 行内注释，避免解析歧义。
#      <REQUIRED_FOR_REAL_LLM> 标记的项只有在 MOCK_LLM=false 时才必填。
# =============================================================================

# -----------------------------------------------------------------------------
# 0. 通用
# -----------------------------------------------------------------------------
# Compose 项目名。两套 compose 文件共用同一项目名，才能复用 ecom-net 与数据卷。
COMPOSE_PROJECT_NAME=xingtu-ecom
# dev / prod。prod 会关闭接口文档、收紧日志中的提示信息
APP_ENV=dev
# 容器时区，影响日志与 DATETIME 默认值
TZ=Asia/Shanghai
# 镜像 tag，灰度发布时用于并存两版后端镜像
IMAGE_TAG=dev
# Java 后端 JVM 参数（Python 后端忽略）
JAVA_TOOL_OPTIONS=-Xms512m -Xmx1024m

# -----------------------------------------------------------------------------
# 1. 宿主机端口映射（仅影响 docker-compose 的 ports，不影响服务间通信）
# -----------------------------------------------------------------------------
FRONTEND_PORT=8088
# 两套后端容器内监听端口，同时也是宿主机映射端口
APP_PORT_PYTHON=8000
APP_PORT_JAVA=8080
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_PORT=15672
MILVUS_HOST_PORT=19530
MILVUS_METRICS_PORT=9091
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
ETCD_HOST_PORT=2379

# -----------------------------------------------------------------------------
# 2. MySQL 8.0
# -----------------------------------------------------------------------------
# root 密码，仅 compose 初始化与运维使用
MYSQL_ROOT_PASSWORD=root123
# compose 侧建库名（与 MYSQL_DB 保持一致）
MYSQL_DATABASE=ecom_agent
# —— 以下 5 项为后端读取的变量（docs/00 约定），HOST 必须是服务名 mysql ——
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=ecom_agent
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom123

# -----------------------------------------------------------------------------
# 3. Redis 7
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# 留空表示无密码启动（healthcheck 自适应）；生产必须设置
REDIS_PASSWORD=ecom123
REDIS_DB=0

# -----------------------------------------------------------------------------
# 4. RabbitMQ 3.13-management
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ecom
RABBITMQ_PASSWORD=ecom123
RABBITMQ_VHOST=ecom

# -----------------------------------------------------------------------------
# 5. Milvus 2.5 standalone（依赖 etcd + MinIO）
# -----------------------------------------------------------------------------
MILVUS_HOST=milvus
MILVUS_PORT=19530
# 集合名前缀，实际集合：ecom_knowledge / ecom_product / ecom_memory
MILVUS_COLLECTION_PREFIX=ecom
# Milvus 开启鉴权后填写（默认关闭，留空即无鉴权）
MILVUS_TOKEN=

# MinIO：既是 Milvus 的对象存储，也是知识库原始文件的存放处
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# 后端访问 MinIO 的地址与桶（与上面账号密码保持一致）
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=ecom-files

# -----------------------------------------------------------------------------
# 6. 大模型
# -----------------------------------------------------------------------------
# deepseek / qwen / openai / ollama / mock；mock 表示完全离线（CI 与首次体验）
LLM_PRIMARY=deepseek
# true 时全链路走确定性 Mock，不产生任何外网调用与费用；首次体验保持 true
MOCK_LLM=true
# —— DeepSeek（默认主模型）——
# <REQUIRED_FOR_REAL_LLM>
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# —— 通义千问（第一兜底 + 快模型）——
# <REQUIRED_FOR_REAL_LLM>
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_FAST_MODEL=qwen-turbo
# —— OpenAI（第二兜底，可留空）——
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# —— 本地 Ollama（可选，需自行启动 ollama 服务）——
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
# 7. 向量化 / 重排
# -----------------------------------------------------------------------------
# dashscope / openai / ollama / hash；hash 为确定性离线实现（CI 与首次体验必用）
EMBEDDING_PROVIDER=hash
# provider=hash 时该值仅用于元数据展示
EMBEDDING_MODEL=text-embedding-v3
# 必须为 1024，三个 Milvus 集合统一维度，改动需重建集合
EMBEDDING_DIM=1024
# llm / none；none 时跳过重排直接按 RRF 分数截断
RERANK_PROVIDER=llm

# -----------------------------------------------------------------------------
# 8. 安全与 Agent 运行时
# -----------------------------------------------------------------------------
# 生产必须替换为 >=32 字节随机串：openssl rand -hex 32
JWT_SECRET=change-me-in-prod-please-32bytes-min
# Agent 最大步数（终止条件 2）
MAX_STEPS=12
# 单任务 token 预算（终止条件 3）
MAX_TOKEN_BUDGET=60000
# 单任务超时秒数（终止条件 4）
TASK_TIMEOUT_SECONDS=120
# 退款金额阈值（分），超过即强制人工审批；100000 = 1000 元
APPROVAL_AMOUNT_THRESHOLD_CENTS=100000
# 每用户每分钟请求数
RATE_LIMIT_PER_MINUTE=30
# SSE 心跳间隔（秒），须小于 nginx proxy_read_timeout
SSE_HEARTBEAT_SECONDS=15
# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# 说明：docs/00 中的 SERVER_PORT 不在此设置。
#      compose 会把 APP_PORT_PYTHON 注入 Python 容器的 SERVER_PORT/APP_PORT，
#      把 APP_PORT_JAVA 注入 Java 容器的 SERVER_PORT/APP_PORT。
#      本地裸跑后端时自行 export SERVER_PORT=8000（Python）/ 8080（Java）。

# ---------------------------------------------------------------------------
# RAG 切块参数（两端必须一致，否则同一文档切分不同、引用序号对不齐）
# ---------------------------------------------------------------------------
# Python 读 CHUNK_SIZE / CHUNK_OVERLAP
CHUNK_SIZE=400
CHUNK_OVERLAP=80
# Java 读 RAG_CHUNK_SIZE / RAG_CHUNK_OVERLAP，取值必须与上面相同
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
