# ===== 前端环境变量（Vite 只暴露 VITE_ 前缀）=====

# axios 基地址。默认 /api；本地开发推荐 /api/v1（交给 Vite proxy / nginx 转发）
# 也可直接填完整地址，如 http://localhost:8000/api/v1
VITE_API_BASE=/api/v1

# 仅本地开发使用：Vite dev server 的 /api 代理目标
VITE_PROXY_TARGET=http://localhost:8000

# 「设置」页可切换的两套后端（导航栏切换器据此生成选项）
VITE_BACKEND_PYTHON=http://localhost:8000/api/v1
VITE_BACKEND_JAVA=http://localhost:8080/api/v1

# 普通请求超时（毫秒）；SSE 不受此限制
VITE_REQUEST_TIMEOUT=20000

# 页面标题
VITE_APP_TITLE=电商智能体控制台
