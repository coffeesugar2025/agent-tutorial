*.log
logs/

# 密钥与本地环境；示例文件保留
.env
.env.*
!.env.example
!.env.*.example

# ==========================================
# Java / JVM（Maven + Gradle）
# ==========================================
target/
.gradle/
build/
# Eclipse 输出目录，若项目里有同名脚本目录请勿启用
# bin/

*.class
hs_err_pid*
replay_pid*

# 若根目录会散落 jar/war 且确认不提交，再按需启用；
# 启用时必须排除 wrapper，否则 CI 会拉不到构建工具
# *.jar
# *.war
# !.mvn/wrapper/maven-wrapper.jar
# !gradle/wrapper/gradle-wrapper.jar

