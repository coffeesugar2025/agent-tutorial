{
  "name": "ecom-agent-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "电商智能体控制台（Vue 3 + Vite + TypeScript + Element Plus），同时对接 Python / Java 双后端",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 8088",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "markdown-it": "^14.1.0",
    "pinia": "^2.2.4",
    "vue": "^3.4.38",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "sass": "^1.79.4",
    "typescript": "~5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "vue-tsc": "^2.1.6"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
