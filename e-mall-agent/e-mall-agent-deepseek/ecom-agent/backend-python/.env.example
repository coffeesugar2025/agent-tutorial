# ============================================================================
# 星图商城 · 电商智能体后端（Python）环境变量样例
# 变量名与 docs/00-开发约定.md 第 2 节完全一致，Java 端同名同义。
# 复制为 .env 后按需修改；MOCK_LLM=true 时无需任何 API Key。
# ============================================================================

APP_ENV=dev
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai

# --- MySQL ----------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=ecom_agent
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom123
DB_ECHO=false
# 显式覆盖连接串（测试用 SQLite 时设置，优先级最高）
# DATABASE_URL=sqlite+pysqlite:///./var/ecom_test.db
AUTO_CREATE_TABLES=false

# --- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ecom
RABBITMQ_PASSWORD=ecom123
RABBITMQ_VHOST=ecom
MQ_ENABLED=true
MQ_CONSUMER_ENABLED=true

# --- Milvus ---------------------------------------------------------------
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=ecom
# auto: 优先 Milvus，不可用自动降级；memory: 强制内存；milvus: 强制 Milvus
VECTOR_STORE=auto

# --- LLM ------------------------------------------------------------------
LLM_PRIMARY=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_FAST_MODEL=qwen-turbo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
# 逗号分隔的兜底供应商链
LLM_FALLBACKS=qwen,openai
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT_SECONDS=60
# native: 自研主循环（默认）; langchain: create_agent 图引擎（实验）
AGENT_ENGINE=native

# --- Embedding / Rerank ---------------------------------------------------
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RERANK_PROVIDER=llm
RERANK_TOP_N=5

# --- 安全 -----------------------------------------------------------------
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=86400
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=*

# --- Agent 运行时 ---------------------------------------------------------
MAX_STEPS=12
MAX_TOKEN_BUDGET=60000
TASK_TIMEOUT_SECONDS=120
APPROVAL_AMOUNT_THRESHOLD_CENTS=100000
APPROVAL_TIMEOUT_SECONDS=1800
SUMMARY_TRIGGER_MESSAGES=20
MEMORY_HALF_LIFE_DAYS=30

# --- RAG ------------------------------------------------------------------
KNOWLEDGE_TOP_K=5
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_SPARSE_TOP_K=20
UPLOAD_DIR=var/uploads
MAX_UPLOAD_MB=20

# --- Mock 总开关（CI / 本地体验必须为 true） ------------------------------
MOCK_LLM=false
