# ============================================================================
# backend-java 环境变量（与 Python 端同名同义，见 docs/00-开发约定.md 第 2 节）
# 复制为 .env 后按需修改；docker-compose 会注入同名变量。
# ============================================================================
APP_ENV=dev
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- MySQL ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=ecom_agent
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom123

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ecom
RABBITMQ_PASSWORD=ecom123
RABBITMQ_VHOST=ecom
MQ_ENABLED=true

# --- Milvus（REST v2，端口 19530 为 gRPC，REST 由 9091 暴露）---
MILVUS_ENABLED=true
MILVUS_HOST=milvus
MILVUS_PORT=9091
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION_PREFIX=ecom

# --- LLM ---
# deepseek / qwen / openai / ollama / mock
LLM_PRIMARY=deepseek
MOCK_LLM=false
LLM_FALLBACK_CHAIN=deepseek,qwen,qwen-turbo,openai,ollama,mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_FAST_MODEL=qwen-turbo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Embedding ---
# dashscope / openai / ollama / hash
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- RAG ---
RERANK_PROVIDER=llm
RAG_CHUNK_SIZE=520
RAG_CHUNK_OVERLAP=80

# --- Agent 运行时 ---
MAX_STEPS=12
MAX_TOKEN_BUDGET=60000
TASK_TIMEOUT_SECONDS=120
APPROVAL_AMOUNT_THRESHOLD_CENTS=100000
RATE_LIMIT_PER_MINUTE=30
MEMORY_WINDOW=20
SUMMARY_THRESHOLD=40

# --- 安全 ---
JWT_SECRET=change-me-in-prod
JWT_EXPIRE_SECONDS=86400

# --- 计费（分 / 百万 token）---
PRICE_INPUT_CENTS=200
PRICE_OUTPUT_CENTS=800

# --- 沙箱 ---
SANDBOX_ENABLED=true
