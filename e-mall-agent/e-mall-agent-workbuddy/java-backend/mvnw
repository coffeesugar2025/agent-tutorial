#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper (official-style, auto-downloads maven-wrapper.jar)
# Usage: ./mvnw spring-boot:run | ./mvnw test
# ----------------------------------------------------------------------------
set -e

BASE_DIR=$(cd "$(dirname "$0")" && pwd)
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
PROPS="$WRAPPER_DIR/maven-wrapper.properties"

if [ ! -f "$PROPS" ]; then
  echo "Missing $PROPS" >&2
  exit 1
fi

wrapperUrl=$(sed -n 's/^wrapperUrl=//p' "$PROPS" | tr -d '\r')
if [ -z "$wrapperUrl" ]; then
  wrapperUrl="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
fi

JAR="$WRAPPER_DIR/maven-wrapper.jar"
if [ ! -f "$JAR" ]; then
  mkdir -p "$WRAPPER_DIR"
  echo "Downloading Maven Wrapper jar ..." >&2
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$JAR" "$wrapperUrl"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$JAR" "$wrapperUrl"
  else
    echo "curl or wget is required to bootstrap Maven Wrapper" >&2
    exit 1
  fi
fi

exec java -classpath "$JAR" \
  "-Dmaven.multiModuleProjectDirectory=$BASE_DIR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
