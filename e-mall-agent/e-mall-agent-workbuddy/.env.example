# ============================================================
# 电商智能体 Docker Compose 环境变量示例
# 使用：cp .env.example .env 后按需修改；生产环境务必更换所有口令与密钥
# ============================================================

# ---------------- 宿主机端口映射 ----------------
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
PYTHON_BACKEND_PORT=8000
JAVA_BACKEND_PORT=8080
FRONTEND_PORT=80

# ---------------- MySQL ----------------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=ecom_agent
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom123456
# Java 后端 JDBC 连接串（Python 侧用 ECOM_MYSQL_URL，见下方）
MYSQL_URL=jdbc:mysql://mysql:3306/ecom_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_DRIVER=com.mysql.cj.jdbc.Driver

# ---------------- Redis ----------------
# 留空即关闭鉴权（仅建议本地 demo）
REDIS_PASSWORD=redis123456

# Java 后端功能开关（容器内网可达时建议开启）
REDIS_MEMORY_ENABLED=true
EVENT_PUBLISH_ENABLED=true
MILVUS_ENABLED=true
MILVUS_TOKEN=

# ---------------- RabbitMQ ----------------
RABBITMQ_USER=ecom
RABBITMQ_PASSWORD=rabbit123456

# ---------------- MinIO（Milvus 对象存储）----------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123456

# ---------------- etcd（Milvus 元数据）----------------
ETCD_NAME=etcd0
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380

# ---------------- Milvus ----------------
# 连接串由 compose 内部服务名解析，一般无需修改
ECOM_MILVUS_URL=http://milvus:19530

# ---------------- Python 后端（FastAPI / LangChain 1.5）----------------
ECOM_DEBUG=false
# offline（离线确定性模型，无需 Key）| openai（真实模型）
ECOM_LLM_PROVIDER=offline
ECOM_LLM_MODEL=gpt-4o-mini
ECOM_OPENAI_API_KEY=
# local（进程内 MCP）| http（独立 MCP Server）
ECOM_MCP_MODE=local
ECOM_SECRET_KEY=change-me-in-production
ECOM_CONTEXT_MAX_CHARS=3200
ECOM_CONTEXT_RECENT_MESSAGES=8
ECOM_RAG_TOP_K=3
# 以下为接入真实中间件预留，当前应用使用内存仓储
ECOM_MYSQL_URL=mysql+pymysql://ecom:ecom123456@mysql:3306/ecom_agent
ECOM_REDIS_URL=redis://:redis123456@redis:6379/0
ECOM_RABBITMQ_URL=amqp://ecom:rabbit123456@rabbitmq:5672/

# ---------------- 多模型网关 / 厂商密钥（按需填写）----------------
# 供应商清单，逗号分隔；默认仅 offline。示例：offline,deepseek,qwen
ECOM_LLM_PROVIDERS=offline
ECOM_LLM_DEFAULT_PROVIDER=offline
ECOM_MILVUS_TOKEN=
ECOM_DEEPSEEK_API_KEY=
ECOM_QWEN_API_KEY=
ECOM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ECOM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 兼容别称（Java 侧或旧脚本使用）
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ---------------- Java 后端（Spring Boot / LangChain4j）----------------
SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ecom_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
LANGCHAIN4J_OPEN_AI_API_KEY=

# ---------------- 前端网关 ----------------
# 默认走 Python 后端；切换 Java 后端改为 backend-java:8080
UPSTREAM_BACKEND=backend-python:8000
