# copy to .env to override defaults
ECOM_DEBUG=false
ECOM_LLM_PROVIDER=offline          # offline | openai
ECOM_LLM_MODEL=gpt-4o-mini
ECOM_OPENAI_API_KEY=
ECOM_MCP_MODE=local                # local | http
ECOM_MCP_HTTP_URL=http://127.0.0.1:8001/mcp
ECOM_CONTEXT_MAX_CHARS=3200
ECOM_CONTEXT_RECENT_MESSAGES=8
ECOM_RAG_TOP_K=3
ECOM_SECRET_KEY=change-me-in-production

# ---- 生产基础设施（留空 = 自动回退内存/离线实现）----
ECOM_MYSQL_URL=                     # mysql+pymysql://user:pass@host:3306/ecom
ECOM_REDIS_URL=                     # redis://:pass@host:6379/0
ECOM_RABBITMQ_URL=                  # amqp://user:pass@host:5672/
ECOM_MILVUS_URL=                    # http://host:19530
ECOM_MILVUS_TOKEN=

# ---- 多模型网关（逗号分隔；offline 为确定性兜底）----
ECOM_LLM_PROVIDERS=offline          # 例：deepseek,qwen,offline
ECOM_LLM_DEFAULT_PROVIDER=offline
ECOM_DEEPSEEK_API_KEY=
ECOM_QWEN_API_KEY=
ECOM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
ECOM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
