# copy to .env to override defaults
ECOM_DEBUG=false
ECOM_LLM_PROVIDER=offline          # offline | openai
ECOM_LLM_MODEL=gpt-4o-mini
ECOM_OPENAI_API_KEY=
ECOM_MCP_MODE=local                # local | http
ECOM_MCP_HTTP_URL=http://127.0.0.1:8001/mcp
ECOM_CONTEXT_MAX_CHARS=3200
ECOM_CONTEXT_RECENT_MESSAGES=8
ECOM_RAG_TOP_K=3
ECOM_SECRET_KEY=change-me-in-production
