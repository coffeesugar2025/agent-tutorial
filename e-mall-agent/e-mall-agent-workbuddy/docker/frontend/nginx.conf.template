# nginx 配置模板：容器启动时由官方 entrypoint 的 envsubst 注入 ${UPSTREAM_BACKEND}
# 示例：UPSTREAM_BACKEND=backend-java:8080 即可整体切换后端，无需重建镜像
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;

    # 静态资源压缩
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript
               application/xml text/javascript image/svg+xml;

    # 运行时配置：禁用缓存，便于容器启动后覆盖 config.js
    location = /config.js {
        add_header Cache-Control "no-store, must-revalidate";
        try_files $uri =404;
    }

    # API 反向代理（含 SSE 流式响应支持）
    location /api/ {
        proxy_pass http://${UPSTREAM_BACKEND}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        proxy_cache off;
    }

    location = /api {
        return 301 /api/;
    }

    # 带哈希的静态资源长期缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Vue Router history 模式 fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
